# CloudBase (optional — leave empty for local-only / offline dictionary use)
WXT_CLOUDBASE_ENV=
WXT_CLOUDBASE_REGION=ap-shanghai
WXT_CLOUDBASE_ACCESS_KEY=

# Public HTTPS endpoint for ZIP update checks (no secret or login required).
# Must end in /extension-release when used.
WXT_UPDATE_CHECK_URL=

# Public read-only HTTP API for learning content (no login required)
WXT_PUBLIC_API_URL=https://example.com/public-learning

# Optional analytics ingest URL
WXT_ANALYTICS_URL=
